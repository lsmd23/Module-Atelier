{
  "name": "module-atelier",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @module-atelier/api dev",
    "docker:frontend:config": "docker compose --env-file apps/web/frontend.env -f apps/web/docker-compose.yml config",
    "docker:frontend:up": "docker compose --env-file apps/web/frontend.env -f apps/web/docker-compose.yml up --build -d",
    "docker:frontend:down": "docker compose --env-file apps/web/frontend.env -f apps/web/docker-compose.yml down",
    "docker:frontend:logs": "docker compose --env-file apps/web/frontend.env -f apps/web/docker-compose.yml logs -f web",
    "web:build": "pnpm --filter @module-atelier/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
