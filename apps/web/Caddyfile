{
  auto_https off
  admin off
}

:8080 {
  encode gzip

  @api path /api/*
  header {
    -Server
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Frame-Options "SAMEORIGIN"
  }

  handle @api {
    reverse_proxy {$API_UPSTREAM}
  }

  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }
}
