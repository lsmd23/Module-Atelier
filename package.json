{
  "name": "module-atelier",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "pnpm --filter @module-atelier/api dev",
    "db:generate": "pnpm --filter @module-atelier/db generate",
    "db:migrate": "pnpm --filter @module-atelier/db migrate",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
