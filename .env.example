# Copy to .env and adjust for your machine. Never commit real values.

# PostgreSQL connection used by the API and by Drizzle migrations.
DATABASE_URL=postgres://lsmd@localhost:5433/module_atelier

# HTTP listener for apps/api.
API_HOST=127.0.0.1
API_PORT=3000

# pino level used by Fastify: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# M0 has no authentication. Every write is attributed to this actor id in the
# revisions table until Better Auth replaces it.
DEFAULT_ACTOR_ID=local-author

# Database used by the Vitest suites. It is created and truncated by the tests,
# so the name must end with "_test" or the test helpers refuse to run.
TEST_DATABASE_URL=postgres://lsmd@localhost:5433/module_atelier_test