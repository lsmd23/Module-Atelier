# Copy this file to infra/backend.env before using Docker Compose.
# Never commit infra/backend.env or real credentials.

POSTGRES_DB=module_atelier
POSTGRES_USER=module_atelier
# Use a strong URL-safe password for a deployment environment.
POSTGRES_PASSWORD=change-me-before-deploy

# The API is bound to localhost by default. Put Caddy or another reverse proxy
# in front of it before exposing it outside the host.
API_BIND_ADDRESS=127.0.0.1
API_PORT=3000
LOG_LEVEL=info
DEFAULT_ACTOR_ID=local-author
