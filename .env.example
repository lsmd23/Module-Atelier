# Copy to .env and adjust for your machine. Never commit real values.

# PostgreSQL connection used by the API and by Drizzle migrations.
DATABASE_URL=postgres://lsmd@localhost:5433/module_atelier

# HTTP listener for apps/api.
API_HOST=127.0.0.1
API_PORT=3000

# pino level used by Fastify: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Until phase 2 lands, writes made without a session are attributed to this actor
# id. Signed-in writes are attributed to the real user id.
DEFAULT_ACTOR_ID=local-author

# Session signing secret. Required: the API refuses to start without it.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public base URL of this API. Decides the cookie `secure` flag and is always a
# trusted origin for cookie-bearing requests.
BETTER_AUTH_URL=http://127.0.0.1:3000

# Public sign-up. Off by default: the first account is always admitted, later
# ones need an invitation (phase 2) or ALLOW_REGISTRATION=true.
ALLOW_REGISTRATION=false

# Extra origins allowed to send cookies. The Vite dev server is a different
# origin from the API even when it proxies /api, so it must be listed here.
AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Development only: returns the email verification code in the API response so
# you do not have to read the server log. Must stay false in any deployment.
AUTH_DEV_EXPOSE_CODE=false

# Database used by the Vitest suites. It is created and truncated by the tests,
# so the name must end with "_test" or the test helpers refuse to run.
TEST_DATABASE_URL=postgres://lsmd@localhost:5433/module_atelier_test