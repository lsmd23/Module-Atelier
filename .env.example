# Copy to .env and adjust for your machine. Never commit real values.

# Local-first data directory. Leave empty to use the platform default.
MODULE_ATELIER_DATA_DIR=

# HTTP listener for apps/api.
API_HOST=127.0.0.1
API_PORT=30017

# pino level used by Fastify: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Until phase 2 lands, writes made without a session are attributed to this actor
# id. Signed-in writes are attributed to the real user id.
DEFAULT_ACTOR_ID=local-author

# Session signing secret. Required: the API refuses to start without it.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public base URL of this API. Decides the cookie `secure` flag and is always a
# trusted origin for cookie-bearing requests.
BETTER_AUTH_URL=http://127.0.0.1:30017

# Extra origins allowed to send cookies. The Vite dev server is a different
# origin from the API even when it proxies /api, so it must be listed here.
AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Accounts are local and use username/password setup; no mail transport is
# required. The first account is created through /api/auth/setup.
